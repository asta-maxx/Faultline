# Additional Infra environment variables for Faultline
# Done: both are merged into the root .env.example, which is the one to copy.
# Kept here for the compose and Railway setups that read infra/ on its own.

# FalkorDB password (optional). Compose starts FalkorDB with --requirepass when it is set,
# and the app adds it to FALKOR_URL itself (graph/connection.py).
FALKOR_PASSWORD=

# Enables POST /api/reingest (header X-Reingest-Token). Unset: the endpoint returns 503.
REINGEST_TOKEN=
