FALKOR_URL=redis://localhost:6379
# Port 6379 taken by another Redis? Run FalkorDB on 6380 and use redis://localhost:6380 (README, Run it locally).
# Optional. Added to FALKOR_URL as redis://:<password>@... when the URL has no credentials (graph/connection.py).
FALKOR_PASSWORD=
# Enables POST /api/reingest (header X-Reingest-Token). Unset: the endpoint returns 503.
REINGEST_TOKEN=
# Free tiers only. Register your own keys; never share one (CONTRACT §2).
# Groq: extraction, entity resolution, judge overflow. Gemini: judging, entity consolidation, /draft.
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional per-role model overrides, "provider:model". The values shown are the defaults.
# FAULTLINE_EXTRACT_MODEL=groq:openai/gpt-oss-120b
# FAULTLINE_EXTRACT_OVERFLOW_MODEL=groq:openai/gpt-oss-20b
# FAULTLINE_JUDGE_MODEL=gemini:gemini-3.5-flash
# FAULTLINE_JUDGE_OVERFLOW_MODEL=groq:openai/gpt-oss-120b
# FAULTLINE_CONSOLIDATE_MODEL=gemini:gemini-3.5-flash
# FAULTLINE_EMBED_MODEL is defined in agent/llm.py but unused: nothing calls embeddings.
# LLM response cache. Default: cache/ at the repo root. The Docker image sets /cache.
# FAULTLINE_CACHE_DIR=
# 1 serves fixtures/ for /api/stats, /api/conflicts and /api/conflicts/{id} instead of the graph.
# FAULTLINE_FIXTURES=1
# Folder sources must sit under this path. Unset: any folder on the API's machine is accepted.
# FAULTLINE_SOURCE_ROOT=
# Where the Vite dev server proxies /api/* (web/vite.config.ts). Default http://localhost:8000.
# FAULTLINE_API=
